{
  "name": "cclaw",
  "version": "0.1.0",
  "description": "A Claude-Code-shaped terminal agent that runs on the Cursor CLI",
  "license": "MIT",
  "type": "module",
  "private": true,
  "bin": {
    "cclaw": "./src/cli.ts"
  },
  "scripts": {
    "cclaw": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --ignore-pattern 'src/vendor/**'",
    "fmt": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\"",
    "test": "bun test src",
    "check": "bun run fmt:check && bun run lint:sh && bun run typecheck && bun run test",
    "build": "bun build src/cli.ts --compile --outfile dist/cclaw",
    "test:watch": "bun test src --watch",
    "lint:sh": "shellcheck -x install.sh bin/cclaw && shfmt -d -i 2 -ci -sr -bn install.sh bin/cclaw"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.7.0",
    "@clack/prompts": "1.8.1",
    "@earendil-works/pi-tui": "^1.0.4",
    "chalk": "6.0.0",
    "ipaddr.js": "2.5.0",
    "libphonenumber-js": "1.13.13",
    "p-limit": "^7.3.3",
    "string-width": "8.2.2",
    "typebox": "1.3.34",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ws": "^8.18.2",
    "oxlint": "^1.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
